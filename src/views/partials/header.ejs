<!DOCTYPE html>
<html lang="ru" data-theme="<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.theme === 'light') ? 'light' : 'dark' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TaskTracker</title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#171923">
  <link rel="icon" href="/icon-192.png">
  <link rel="apple-touch-icon" href="/icon-192.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="TaskTracker">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/"><span class="brand-mark">✓</span>TaskTracker</a>
    <nav class="app-nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>"><span class="nav-icon">🏠</span><span class="nav-label">Дашборд</span></a>
      <a href="/tasks" class="<%= path.startsWith('/tasks') ? 'active' : '' %>"><span class="nav-icon">✅</span><span class="nav-label">Задачи</span></a>
      <a href="/shopping" class="<%= path.startsWith('/shopping') ? 'active' : '' %>"><span class="nav-icon">🛒</span><span class="nav-label">Покупки</span></a>
      <a href="/progress" class="<%= path.startsWith('/progress') ? 'active' : '' %>"><span class="nav-icon">📊</span><span class="nav-label">Прогресс</span></a>
      <a href="/friends" class="<%= path.startsWith('/friends') ? 'active' : '' %>"><span class="nav-icon">👥</span><span class="nav-label">Друзья</span><% if (pendingFriendRequests > 0) { %><span class="badge"><%= pendingFriendRequests %></span><% } %></a>
      <a href="/transfers" class="<%= path.startsWith('/transfers') ? 'active' : '' %>"><span class="nav-icon">🔁</span><span class="nav-label">Передачи</span><% if (pendingTransferCount > 0) { %><span class="badge"><%= pendingTransferCount %></span><% } %></a>
    </nav>
    <div class="topbar-actions">
      <button type="button" id="install-btn" class="icon-btn hidden" title="Установить на телефон">⬇️</button>
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin" class="icon-btn <%= path.startsWith('/admin') ? 'active' : '' %>" title="Админка">🛠<% if (unreadSupportForAdmin > 0) { %><span class="badge"><%= unreadSupportForAdmin %></span><% } %></a>
      <% } %>
      <a href="/support" class="icon-btn <%= path.startsWith('/support') ? 'active' : '' %>" title="Поддержка">❔</a>
      <a href="/notifications" class="icon-btn <%= path.startsWith('/notifications') ? 'active' : '' %>" title="Уведомления">🔔<% if (unreadNotifications > 0) { %><span class="badge"><%= unreadNotifications %></span><% } %></a>
      <a href="/profile" class="icon-btn avatar avatar-<%= currentUser.avatar_color %> <%= path.startsWith('/profile') ? 'active' : '' %>" title="Профиль"><%= currentUser.display_name[0] %></a>
      <form action="/logout" method="post" class="logout-form">
        <button type="submit" class="ghost-btn">Выйти</button>
      </form>
    </div>
  </div>
</header>
<% } %>
<main class="container">
