<%- include('partials/header') %>
<h1>Уведомления</h1>
<% if (!items.length) { %>
  <p class="muted">Пока пусто.</p>
<% } %>
<ul class="task-list">
  <% items.forEach(n => { %>
    <li class="task-row <%= n.read_at ? '' : 'unread' %>">
      <span><%= n.message %></span>
      <% const href = n.link || (n.task_id ? '/tasks/' + n.task_id : null); %>
      <% if (href) { %><a href="<%= href %>" class="muted">открыть →</a><% } %>
    </li>
  <% }) %>
</ul>
<%- include('partials/footer') %>
