<%- include('partials/header') %>
<h1>Друзья</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>

<form method="post" action="/friends/request" class="inline-form">
  <input type="text" name="username" placeholder="Логин друга" required>
  <button type="submit">Отправить запрос</button>
</form>

<% if (incoming.length) { %>
  <h2>Входящие запросы</h2>
  <ul class="task-list">
    <% incoming.forEach(f => { %>
      <li class="task-row">
        <span><strong><%= f.from_name %></strong> (<%= f.from_username %>) хочет добавить вас в друзья</span>
        <form method="post" action="/friends/<%= f.id %>/accept" class="inline-form"><button type="submit">Принять</button></form>
        <form method="post" action="/friends/<%= f.id %>/decline" class="inline-form"><button type="submit" class="danger">Отклонить</button></form>
      </li>
    <% }) %>
  </ul>
<% } %>

<% if (outgoing.length) { %>
  <h2>Исходящие запросы</h2>
  <ul class="task-list">
    <% outgoing.forEach(f => { %>
      <li class="task-row">
        <span>Запрос отправлен <strong><%= f.to_name %></strong> (<%= f.to_username %>) — ожидает ответа</span>
        <form method="post" action="/friends/<%= f.id %>/cancel" class="inline-form"><button type="submit" class="danger">Отменить</button></form>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2>Мои друзья</h2>
<% if (!friends.length) { %><p class="muted">Пока никого — отправьте запрос по логину выше.</p><% } %>
<ul class="task-list friend-list">
  <% friends.forEach(f => { %>
    <li class="task-row friend-row">
      <div class="friend-name">
        <strong><%= f.display_name %></strong>
        <span class="muted small">@<%= f.username %></span>
        <% if (f.tag) { %><span class="tag tag-violet"><%= f.tag %></span><% } %>
      </div>
      <form method="post" action="/friends/<%= f.id %>/settings" class="friend-settings-form">
        <input type="text" name="tag" placeholder="Тег: жена, друг…" value="<%= f.tag || '' %>" maxlength="30">
        <label class="checkbox-label"><input type="checkbox" name="can_assign" value="1" <%= f.can_assign ? 'checked' : '' %>> разрешить назначать мне задачи</label>
        <button type="submit" class="small">Сохранить</button>
      </form>
      <form method="post" action="/friends/<%= f.id %>/remove" class="inline-form" onsubmit="return confirm('Убрать из друзей?')">
        <button type="submit" class="danger small">Убрать</button>
      </form>
    </li>
  <% }) %>
</ul>
<%- include('partials/footer') %>
